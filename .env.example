# Copy to ~/.config/jira-tui/.env (recommended) or ./.env
# and fill in real values. Never commit a real .env.

JIRA_BASE_URL=https://jira.example.com

# "bearer" = personal access token (PAT)
# "basic"  = username + password
JIRA_AUTH_MODE=bearer

# Used when JIRA_AUTH_MODE=bearer
JIRA_PAT=

# Used when JIRA_AUTH_MODE=basic
JIRA_USERNAME=
JIRA_PASSWORD=
